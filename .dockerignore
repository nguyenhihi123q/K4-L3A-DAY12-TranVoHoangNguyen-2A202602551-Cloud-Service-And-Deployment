# CP2 — thứ KHÔNG được copy vào image (build context)
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Git
.git
.gitignore

# Secret — TUYỆT ĐỐI không đưa vào image
.env
.env.*

# Rác Python & môi trường ảo
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/

# Tài liệu, ảnh minh chứng — không cần cho runtime
screenshots/
*.md
